# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=5000

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=taskmanager_db
DB_PORT=3306

# JWT Secret — use any long random string (the longer, the better)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL for CORS (only needed in production, optional locally)
FRONTEND_URL=http://localhost:5000

# For Railway MySQL — set this instead of the individual DB_* variables above
# DATABASE_URL=mysql://user:password@host:port/dbname
